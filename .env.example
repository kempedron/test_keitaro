# Keitaro Admin API
KEITARO_BASE_URL=https://tlgk.host/admin_api/v1
KEITARO_API_KEY=replace_with_your_api_key

# Local database (SQLite by default; PostgreSQL is supported)
DATABASE_URL=sqlite:///./app.db

# Campaign name prefix enforced by the app
CAMPAIGN_PREFIX=test_vdovichenko_

# HTTP client
HTTP_TIMEOUT=600
OFFER_CACHE_TTL=60
